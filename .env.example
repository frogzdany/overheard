# Copy to .env and fill in. Never commit the real .env.

# Live speech-to-text. Deepgram remains the default.
STT_PROVIDER=deepgram

# Deepgram (required when STT_PROVIDER=deepgram).
# https://console.deepgram.com
DEEPGRAM_API_KEY=

# OpenAI Realtime transcription (required when STT_PROVIDER=openai).
# Empty uses the default gpt-live-transcribe model.
OPENAI_STT_MODEL=

# Mozilla.ai any-llm — OpenAI is the default; OpenRouter is also supported.
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Action execution service and development-only transcript/tick routes.
HANDS_URL=http://127.0.0.1:8790
# How hands runs an action. `local` dispatches on approval; `trigger` stages a
# Trigger.dev run with an approval waitpoint as soon as the action is suggested.
# Must match the EXECUTOR set for the hands service.
EXECUTOR=local
ENGINE_DEV=0

# Playback speed for `app.py --from-transcript` — multiplies the fixture's own
# timestamps. 1.0 = real time, 2.0 = twice as fast, 0 = no waiting at all.
REPLAY_SPEED=1.0
# Optional isolated storage path for local testing.
OVERHEARD_DATA_DIR=

# Engine worker intervals and thresholds (demo: 20000 makes cards appear faster).
ACTIONS_INTERVAL_MS=
ACTIONS_MIN_NEW_CHARS=

# Mozilla.ai any-guardrail prompt-injection screen for draft_message /
# create_doc actions before they're published. Local CPU model, no API key —
# default off so keyless teammates and anyone without the extra deps are
# unaffected. Set to "on" to enable (first use downloads ~370MB).
GUARDRAIL=off

# --- hands ---
# The hands service (hands/src/server.ts) reads this file too: it loads
# hands/.env then this repo-root .env at startup (without overriding
# variables already set in the environment). See hands/README.md.

# Ambiguous AI coworker key used by hands to call tasks/calendar/chat/docs tools.
AMBIGUOUS_API_KEY=
# MCP endpoint for the Ambiguous workspace hands connects to.
AMBIGUOUS_MCP_URL=https://app.ambiguous.ai/mcp
# Exa API key used by hands for the `lookup` action (Exa answer()).
EXA_API_KEY=
# Trigger.dev secret key, required when hands EXECUTOR=trigger.
TRIGGER_SECRET_KEY=
# Trigger.dev project ref, required when hands EXECUTOR=trigger.
TRIGGER_PROJECT_REF=
# Shared secret hands sends as X-Engine-Token on status callbacks to the engine.
ENGINE_TOKEN=
# Port the hands HTTP service listens on.
HANDS_PORT=8790
