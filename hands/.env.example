EXECUTOR=local
ENGINE_URL=http://127.0.0.1:8765
ENGINE_TOKEN=
HANDS_PORT=8790
HANDS_RESET_CLAIMS=0
AMBIGUOUS_API_KEY=
AMBIGUOUS_MCP_URL=https://app.ambiguous.ai/mcp
# Workspace origin used to build result deep links. Defaults to the origin of AMBIGUOUS_MCP_URL.
AMBIGUOUS_WORKSPACE_URL=
# Where draft_message posts: a channel id, or a channel name (leading # optional).
# Unset picks a DM with the recipient, else the first general-looking channel.
AMBIGUOUS_DEFAULT_CHANNEL=
# Calendar for schedule_followup: a calendar id or name. Unset uses the default calendar.
AMBIGUOUS_DEFAULT_CALENDAR=
# Exact MCP tool names, only if the workspace renames them from the defaults
# (create_task / create_event / send_message / create_document).
AMBIGUOUS_TOOL_TASKS_CREATE=
AMBIGUOUS_TOOL_CALENDAR_CREATE_EVENT=
AMBIGUOUS_TOOL_CHAT_SEND_MESSAGE=
AMBIGUOUS_TOOL_DOCS_CREATE=
EXA_API_KEY=
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
