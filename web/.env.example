# Web app build-time config (Next.js NEXT_PUBLIC_*). Copy to .env.local.

# Where the engine is reached.
NEXT_PUBLIC_ENGINE_URL=http://127.0.0.1:8765

# --- Auth0 (optional) -----------------------------------------------------
# Leave empty to run the dashboard without a sign-in gate. Set all three to
# gate it behind Auth0; CLIENT_ID is the Auth0 Single Page Application client
# id. Add the dashboard origin to Allowed Callback URLs, Allowed Logout URLs,
# and Allowed Web Origins in the Auth0 application settings.
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=

# --- CopilotKit (server-side) ---------------------------------------------
# Used by /api/copilotkit. Leave empty to run the dashboard without chat;
# the sidebar will error on send until OPENAI_API_KEY is set.
OPENAI_API_KEY=
# Chat Completions model. Empty falls back to gpt-5.6-sol (newest gpt-5
# family ChatModel in the installed openai package).
COPILOT_MODEL=
